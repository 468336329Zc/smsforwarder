<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3EDF7"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <EditText
            android:id="@+id/etBotName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="机器人名称" />

        <EditText
            android:id="@+id/etWebhookUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="量子密信 Webhook 地址 (https://...)" />

        <EditText
            android:id="@+id/etKeywords"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="转发关键词（逗号分隔，留空匹配所有短信）" />

        <EditText
            android:id="@+id/etSenderFilters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="监听号码过滤（逗号分隔，留空表示不限制）" />

        <Switch
            android:id="@+id/switchBotEnabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:checked="true"
            android:text="启用机器人" />

        <CheckBox
            android:id="@+id/cbMentioned"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="开启 @提醒功能" />

        <EditText
            android:id="@+id/etMentionMobiles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@指定人员手机号（逗号分隔，留空则@所有人）" />

        <Button
            android:id="@+id/btnSaveBot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="保存" />
    </LinearLayout>
</ScrollView>
