<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kf_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ══════════ 未授权 · 填码页 ══════════ -->
        <LinearLayout
            android:id="@+id/gateContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 品牌头 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="14dp"
                android:paddingBottom="6dp">

                <FrameLayout
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_kf_icon">

                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_key_white" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="11dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"
                        android:textColor="@color/kf_ink"
                        android:textSize="14.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="激活后即可使用"
                        android:textColor="@color/kf_dim2"
                        android:textSize="9.5sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- 标题区 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="这台设备还没有授权"
                    android:textColor="@color/kf_ink"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:lineSpacingExtra="3dp"
                    android:text="把下面的设备码发给卖家，他会给你一串授权码。粘贴进来点激活就能用。"
                    android:textColor="@color/kf_dim2"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <!-- 设备码卡 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_kf_card"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="15dp"
                android:paddingBottom="15dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="你的设备码"
                        android:textColor="@color/kf_ink"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="复制发给卖家"
                        android:textColor="@color/kf_dim2"
                        android:textSize="9.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/deviceCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="11dp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.08"
                    android:lineSpacingExtra="6dp"
                    android:textColor="@color/kf_ink"
                    android:textSize="16.5sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/copyDevice"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_kf_btn_ghost"
                    android:drawableStart="@drawable/ic_copy"
                    android:drawablePadding="6dp"
                    android:elevation="0dp"
                    android:fontFamily="sans-serif"
                    android:stateListAnimator="@null"
                    android:text="复制发给卖家"
                    android:textColor="@color/kf_brand"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 授权码填码卡 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_kf_card"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="15dp"
                android:paddingBottom="15dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="粘贴授权码"
                        android:textColor="@color/kf_ink"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="卖家发给你的那一串"
                        android:textColor="@color/kf_dim2"
                        android:textSize="9.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <EditText
                    android:id="@+id/codeInput"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_marginTop="11dp"
                    android:background="@drawable/bg_kf_codebox"
                    android:fontFamily="monospace"
                    android:gravity="top"
                    android:hint="卖家发给你的那一串"
                    android:inputType="textMultiLine|textNoSuggestions"
                    android:letterSpacing="0.01"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="11dp"
                    android:paddingBottom="11dp"
                    android:textColor="@color/kf_ink"
                    android:textColorHint="#B4C1CD"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="5dp"
                        android:layout_height="5dp"
                        android:background="@color/kf_weak" />

                    <TextView
                        android:id="@+id/codeCounter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:text="粘贴后会自动检查"
                        android:textColor="@color/kf_dim2"
                        android:textSize="9.5sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- 主按钮 -->
            <Button
                android:id="@+id/activateBtn"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_kf_cta"
                android:elevation="0dp"
                android:fontFamily="sans-serif"
                android:stateListAnimator="@null"
                android:text="激活并使用"
                android:textColor="#FFFFFF"
                android:textSize="14.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="26dp"
                android:gravity="center"
                android:text="激活不需要联网"
                android:textColor="@color/kf_weak"
                android:textSize="9.5sp" />
        </LinearLayout>

        <!-- ══════════ 验证中 ══════════ -->
        <LinearLayout
            android:id="@+id/checkingContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="90dp"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:indeterminateTint="@color/kf_brand" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="正在本机验证"
                android:textColor="@color/kf_ink"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="正在激活，请稍等"
                android:textColor="@color/kf_dim2"
                android:textSize="11.5sp" />
        </LinearLayout>

        <!-- ══════════ 结果页（成功 / 失败） ══════════ -->
        <LinearLayout
            android:id="@+id/resultContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="26dp">

                <FrameLayout
                    android:id="@+id/heroIcon"
                    android:layout_width="66dp"
                    android:layout_height="66dp">

                    <ImageView
                        android:id="@+id/heroIconImg"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center" />
                </FrameLayout>

                <TextView
                    android:id="@+id/resultTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textColor="@color/kf_ink"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/resultSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/kf_dim2"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/resultCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_kf_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/expireLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="授权期限"
                    android:textColor="@color/kf_dim2"
                    android:textSize="9.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/expireValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:textColor="@color/kf_ink"
                    android:textSize="19sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/resultNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="3dp"
                android:paddingStart="13dp"
                android:paddingEnd="13dp"
                android:paddingTop="11dp"
                android:paddingBottom="11dp"
                android:textSize="10.5sp" />

            <Button
                android:id="@+id/resultBtn"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="26dp"
                android:background="@drawable/bg_kf_cta"
                android:elevation="0dp"
                android:fontFamily="sans-serif"
                android:stateListAnimator="@null"
                android:textColor="#FFFFFF"
                android:textSize="14.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
